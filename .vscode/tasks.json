{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Milestone 1",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms1.sh",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Milestone 2",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms2.sh ${input:ms2Mode}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Milestone 2 (IK to a point)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms2.sh ik --xyz ${input:ikTarget}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "ms2Mode",
            "type": "pickString",
            "description": "Which input should drive the joints?",
            "options": ["sort", "sine", "constant", "sliders"],
            "default": "sort"
        },
        {
            "id": "ikTarget",
            "type": "promptString",
            "description": "World x y z in meters (pick station: 0.105 0.6 0.6, red bin: 0.55 0.25 0.6)",
            "default": "0.105 0.6 0.6"
        }
    ]
}
