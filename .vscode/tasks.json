{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Milestone 1",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms1.sh",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Milestone 2",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms2.sh ${input:ms2Mode}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Milestone 2 (IK to a point)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms2.sh ik --xyz ${input:ikTarget}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Milestone 3",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ms3.sh ${input:ms3Mode}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Challenge 1",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ch1.sh ${input:ch1Mode}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Run Challenge 2",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run_ch2.sh ${input:ch2Mode}",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "ms2Mode",
            "type": "pickString",
            "description": "Which input should drive the joints?",
            "options": ["sort", "sine", "constant", "sliders"],
            "default": "sort"
        },
        {
            "id": "ikTarget",
            "type": "promptString",
            "description": "World x y z in meters (pick station: 0.105 0.6 0.6, red bin: 0.55 0.25 0.6)",
            "default": "0.105 0.6 0.6"
        },
        {
            "id": "ms3Mode",
            "type": "pickString",
            "description": "sort = colour sorting, forward / inverse = kinematics tests (simulator + ROS2), validate / derive = offline",
            "options": ["sort", "forward", "inverse", "validate", "derive"],
            "default": "sort"
        },
        {
            "id": "ch1Mode",
            "type": "pickString",
            "description": "run = simulator + IK node, verify = FK/IK checks against MuJoCo only",
            "options": ["run", "verify"],
            "default": "run"
        },
        {
            "id": "ch2Mode",
            "type": "pickString",
            "description": "position / velocity = simulator + trajectory_node in that control mode, verify = checks + plots only",
            "options": ["position", "velocity", "verify"],
            "default": "position"
        }
    ]
}
